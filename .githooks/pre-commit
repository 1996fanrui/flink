#!/usr/bin/env bash
# git config core.hooksPath .githooks
# Pre-commit hook: runs mvn spotless:apply only on Maven modules with staged .java files.
# Skips directories without pom.xml (docs, requirements, tools, etc.).
# The hook re-stages formatted files automatically after spotless modifies them.
set -e

ROOT_DIR=$(git rev-parse --show-toplevel)

# Get staged .java files (excluding deletions)
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=d -- '*.java')

if [ -z "$STAGED_JAVA_FILES" ]; then
    exit 0
fi

# Find the nearest Maven module for each changed file
MODULES=""
while IFS= read -r file; do
    dir=$(dirname "$file")
    while [ "$dir" != "." ]; do
        if [ -f "$ROOT_DIR/$dir/pom.xml" ]; then
            MODULES="$MODULES $dir"
            break
        fi
        dir=$(dirname "$dir")
    done
done <<< "$STAGED_JAVA_FILES"

# Deduplicate and build -pl argument
PL_ARG=$(echo "$MODULES" | tr ' ' '\n' | grep -v '^$' | sort -u | paste -sd ',' -)

if [ -z "$PL_ARG" ]; then
    exit 0
fi

echo "[pre-commit] Running spotless:apply on: $PL_ARG"
cd "$ROOT_DIR"
./mvnw spotless:apply -pl "$PL_ARG" -P java11-target -P java11

# Re-stage formatted files
while IFS= read -r file; do
    if [ -f "$ROOT_DIR/$file" ]; then
        git add "$file"
    fi
done <<< "$STAGED_JAVA_FILES"
